# Copy to `.env` in this folder:  cp env.sample .env
# The API key is a SERVER key. It stays in the local Node process behind the
# panel and is never sent to the browser. Never commit it, never host this panel.
APPWRITE_API_KEY=

# Your Appwrite project. Both values come from the console (Overview).
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
