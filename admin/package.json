{
  "name": "ctf-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local admin panel for the NeonCart Bug Hunt. Runs on the admin's machine only; never hosted.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
