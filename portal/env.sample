# Copy to `.env` in this folder and fill in your Appwrite project:
#   cp env.sample .env
#
# Vite embeds these public settings in the bundle at build time, so set them
# before `npm run build` and rebuild after changing either value. The project id
# is public (it ships in the browser bundle); the values are not committed so a
# clone never points at someone else's project.

# Appwrite Console -> your project -> Settings
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
